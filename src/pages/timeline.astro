---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TimelineList from '@/components/TimelineList.astro';
---
<BaseLayout title="Timeline | Hongyuan Zhang" description="张宏远的学习与研究成长时间轴。">
  <header class="page-hero shell"><span class="eyebrow">TIMELINE / GROWTH</span><h1>A record of becoming.</h1><p>只记录确定事实，不用夸张里程碑填满时间。它会随着真实学习与研究经历逐渐生长。</p></header>
  <section class="section"><div class="shell timeline-wrap"><TimelineList /></div></section>
</BaseLayout>
<style>.timeline-wrap { max-width: 820px; }</style>
