---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="404 | Hongyuan Zhang" description="This path hasn't been explored yet.">
  <section class="not-found shell"><div class="code">404</div><div><span class="eyebrow">UNEXPLORED / PATH</span><h1>This path hasn't been explored yet.</h1><p>它可能尚未建立，也可能已经移动到研究工作台的其他位置。</p><a href={import.meta.env.BASE_URL}>Back to Home <span>→</span></a></div></section>
</BaseLayout>
<style>
  .not-found { min-height: 88svh; padding-top: 130px; display: grid; grid-template-columns: 1fr 1.3fr; align-items: center; gap: 80px; }
  .code { color: var(--accent); font: 500 clamp(7rem, 18vw, 18rem)/.8 var(--font-mono); letter-spacing: -.12em; opacity: .2; }
  h1 { margin: 20px 0; font-size: clamp(2.5rem, 6vw, 5.4rem); line-height: 1; letter-spacing: -.05em; }
  p { color: var(--muted); }
  a { margin-top: 28px; display: inline-flex; gap: 40px; border-bottom: 1px solid var(--ink); padding-bottom: 8px; font-weight: 600; }
  @media (max-width: 700px) { .not-found { grid-template-columns: 1fr; gap: 20px; } }
</style>
