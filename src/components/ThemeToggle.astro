---
import { SunMoon } from '@lucide/astro';
---
<button class="theme-toggle" type="button" data-theme-toggle aria-label="切换主题：系统" title="主题：系统"><SunMoon size={18} stroke-width={1.7} /><span data-theme-label>Auto</span></button>
<script>
  let themeController: AbortController | undefined;
  const bindTheme = () => {
    themeController?.abort();
    themeController = new AbortController();
    const { signal } = themeController;
    const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!button) return;
    const media = matchMedia('(prefers-color-scheme: dark)');
    const apply = (value: string) => {
      const dark = value === 'dark' || (value === 'system' && media.matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      document.documentElement.dataset.themePreference = value;
      localStorage.setItem('theme', value);
      const names: Record<string, string> = { system: 'Auto', light: 'Light', dark: 'Dark' };
      const label = button.querySelector('[data-theme-label]');
      if (label) label.textContent = names[value];
      button.title = `主题：${names[value]}`;
      button.setAttribute('aria-label', `切换主题，当前：${names[value]}`);
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#101211' : '#f6f6f3');
    };
    button.addEventListener('click', () => {
      const current = document.documentElement.dataset.themePreference || 'system';
      apply(current === 'system' ? 'light' : current === 'light' ? 'dark' : 'system');
    }, { signal });
    media.addEventListener('change', () => {
      if ((document.documentElement.dataset.themePreference || 'system') === 'system') apply('system');
    }, { signal });
    apply(document.documentElement.dataset.themePreference || 'system');
  };
  bindTheme();
  document.addEventListener('astro:page-load', bindTheme);
</script>
<style>
  .theme-toggle { height: 38px; padding: 0 9px; border: 0; background: transparent; border-radius: 6px; display: inline-flex; align-items: center; gap: 7px; cursor: pointer; }
  .theme-toggle:hover { background: var(--accent-soft); color: var(--accent); }
  .theme-toggle span { color: var(--muted); font: 10px/1 var(--font-mono); }
  @media (max-width: 540px) { .theme-toggle span { display: none; } }
</style>
