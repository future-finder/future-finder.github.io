---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '@/utils/content';
interface Props {
  title: string; description: string; date?: Date; updated?: Date; category?: string;
  tags?: string[]; minutes: number; headings?: { depth: number; slug: string; text: string }[];
  previous?: { title: string; href: string }; next?: { title: string; href: string };
  related?: { title: string; href: string; category: string }[];
}
const { title, description, date, updated, category, tags = [], minutes, headings = [], previous, next, related = [] } = Astro.props;
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout title={`${title} | Hongyuan Zhang`} description={description} type="article" published={date} updated={updated}>
  <div class="reading-progress" data-reading-progress></div>
  <article class="article-shell shell" data-pagefind-body>
    <header class="article-header">
      <span class="eyebrow">{category || 'RESEARCH NOTE'} / {minutes} MIN READ</span>
      <h1 data-pagefind-meta="title">{title}</h1>
      <p data-pagefind-meta="description">{description}</p>
      {(date || updated) && <div class="article-meta">{date && <time datetime={date.toISOString()}>发布于 {formatDate(date)}</time>}{updated && <time datetime={updated.toISOString()}>更新于 {formatDate(updated)}</time>}</div>}
      <div class="tag-list">{tags.map((tag) => <a class="tag" href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div>
    </header>
    <div class="article-grid">
      <div class="prose"><slot /></div>
      {toc.length > 0 && <aside class="toc"><details open><summary>On this page</summary><nav aria-label="文章目录">{toc.map((heading) => <a class:list={{ nested: heading.depth === 3 }} href={`#${heading.slug}`}>{heading.text}</a>)}</nav></details></aside>}
    </div>
    <nav class="article-nav" aria-label="前后文章">
      {previous ? <a href={previous.href}><span>← Previous</span><b>{previous.title}</b></a> : <span></span>}
      {next && <a class="next" href={next.href}><span>Next →</span><b>{next.title}</b></a>}
    </nav>
    {related.length > 0 && <section class="related-posts"><span class="eyebrow">RELATED / WRITING</span><h2>相关文章</h2><div>{related.map((item) => <a href={item.href}><small>{item.category}</small><b>{item.title}</b><span>↗</span></a>)}</div></section>}
  </article>
  <script>
    let articleController: AbortController | undefined;
    const bindArticle = () => {
      articleController?.abort();
      articleController = new AbortController();
      const { signal } = articleController;
      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
      const article = document.querySelector<HTMLElement>('.article-shell');
      if (progress && article) {
        const update = () => {
          const start = article.offsetTop;
          const distance = article.offsetHeight - innerHeight;
          const value = Math.min(1, Math.max(0, (scrollY - start) / distance));
          progress.style.transform = `scaleX(${value})`;
        };
        addEventListener('scroll', update, { passive: true, signal }); update();
      }
      document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
        const button = pre.querySelector<HTMLButtonElement>('.copy-code') || document.createElement('button'); button.className = 'copy-code'; button.type = 'button'; button.textContent = 'Copy';
        button.setAttribute('aria-label', '复制代码');
        button.addEventListener('click', async () => { try { await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || ''); button.textContent = 'Copied'; } catch { button.textContent = '复制失败'; } setTimeout(() => button.textContent = 'Copy', 1500); }, { signal });
        pre.append(button);
      });
    };
    bindArticle(); document.addEventListener('astro:page-load', bindArticle);
  </script>
</BaseLayout>
<style is:global>
  .reading-progress { position: fixed; z-index: 100; left: 0; top: 0; width: 100%; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  .article-shell { padding: 135px 0 80px; }
  .article-header { max-width: 100%; padding-bottom: 34px; border-bottom: 1px solid var(--line); }
  .article-header h1 { margin: 20px 0; font-size: clamp(2rem, 4vw, 3.1rem); line-height: 1.4; letter-spacing: -.025em; font-weight: 500; }
  .article-header > p { max-width: 680px; color: var(--muted); font-size: 1.1rem; }
  .article-meta { display: flex; gap: 20px; margin: 24px 0 16px; color: var(--muted); font: 10px/1 var(--font-mono); }
  .article-grid { display: grid; grid-template-columns: minmax(0, 720px) minmax(0, 220px); justify-content: space-between; gap: 60px; padding-top: 38px; }
  .toc { position: relative; }
  .toc details { position: sticky; top: 108px; }
  .toc summary { cursor: pointer; color: var(--muted); font: 10px/1 var(--font-mono); text-transform: uppercase; letter-spacing: .1em; }
  .toc nav { margin-top: 16px; display: grid; }
  .toc a { padding: 7px 0; color: var(--muted); font-size: .8rem; line-height: 1.35; border-left: 1px solid var(--line); padding-left: 12px; }
  .toc a:hover { color: var(--accent); border-color: var(--accent); }
  .toc a.nested { padding-left: 24px; }
  .copy-code { position: absolute; right: 10px; top: 10px; padding: 5px 8px; border: 1px solid rgba(255,255,255,.18); border-radius: 5px; background: rgba(0,0,0,.4); color: #d7ded7; font: 9px/1 var(--font-mono); cursor: pointer; }
  .article-nav { margin-top: 90px; padding-top: 26px; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
  .article-nav a { display: grid; gap: 6px; }
  .article-nav span { color: var(--muted); font: 9px/1 var(--font-mono); text-transform: uppercase; }
  .article-nav b { font-size: .9rem; }
  .article-nav .next { text-align: right; }
  .related-posts { margin-top: 70px; padding-top: 28px; border-top: 1px solid var(--ink); }
  .related-posts h2 { margin: 12px 0 22px; font-size: 1.4rem; }
  .related-posts > div { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .related-posts a { min-height: 150px; padding: 16px; border: 1px solid var(--line); border-radius: 8px; display: grid; grid-template-rows: auto 1fr auto; }
  .related-posts a:hover { border-color: var(--accent); }
  .related-posts small { color: var(--accent); font: 9px/1 var(--font-mono); }
  .related-posts b { margin-top: 14px; font-size: .88rem; }
  .related-posts a > span { justify-self: end; color: var(--muted); }
  @media (max-width: 980px) { .article-grid { grid-template-columns: 1fr; gap: 30px; } .toc { grid-row: 1; } .toc details { position: static; border: 1px solid var(--line); padding: 15px; border-radius: 8px; } }
  @media (max-width: 640px) { .article-shell { padding-top: 120px; } .article-meta { flex-direction: column; gap: 8px; } .related-posts > div { grid-template-columns: 1fr; } }
</style>
