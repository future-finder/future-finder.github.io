---
import { timeline } from '@/data/timeline';
interface Props { limit?: number; }
const { limit } = Astro.props;
const items = limit ? timeline.slice(0, limit) : timeline;
---
<ol class="timeline-list">
  {items.map((item, index) => <li><span class="timeline-date">{item.date || 'NOW'}</span><span class="timeline-node" aria-hidden="true"></span><div><small>{item.type} / 0{index + 1}</small><h3>{item.title}</h3><p>{item.description}</p></div></li>)}
</ol>
<style>
  .timeline-list { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 90px 16px 1fr; gap: 24px; min-height: 150px; }
  .timeline-date { color: var(--muted); font: 11px/1.5 var(--font-mono); }
  .timeline-node { position: relative; width: 9px; height: 9px; border: 2px solid var(--accent); border-radius: 50%; margin-top: 4px; }
  .timeline-node::after { content: ""; position: absolute; left: 2px; top: 12px; width: 1px; height: 121px; background: var(--line); }
  li:last-child .timeline-node::after { display: none; }
  small { color: var(--accent); font: 9px/1 var(--font-mono); text-transform: uppercase; letter-spacing: .1em; }
  h3 { margin: 10px 0 5px; font-size: 1.05rem; }
  p { margin: 0; color: var(--muted); font-size: .88rem; }
  @media (max-width: 560px) { li { grid-template-columns: 54px 12px 1fr; gap: 14px; min-height: 174px; } .timeline-node::after { height: 145px; } }
</style>
