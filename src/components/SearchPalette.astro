---
import { Search, X, FileText, Sprout, FlaskConical } from '@lucide/astro';
---
<dialog class="search-dialog" data-search-dialog aria-labelledby="search-title">
  <div class="search-panel">
    <header>
      <Search size={20} aria-hidden="true" />
      <h2 id="search-title" class="sr-only">全文搜索</h2>
      <input type="search" placeholder="搜索文章、笔记和项目…" autocomplete="off" data-search-input />
      <button type="button" data-search-close aria-label="关闭搜索"><X size={19} /></button>
    </header>
    <div class="search-hint" data-search-hint><span>输入关键词开始搜索</span><kbd>ESC 关闭</kbd></div>
    <div class="search-results" data-search-results role="status" aria-live="polite"></div>
    <footer><span><FileText size={13} /> Writing</span><span><Sprout size={13} /> Notes</span><span><FlaskConical size={13} /> Projects</span></footer>
  </div>
</dialog>

<script>
  let searchController: AbortController | undefined;
  const bindSearch = () => {
    searchController?.abort();
    searchController = new AbortController();
    const { signal } = searchController;
    const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
    const input = dialog?.querySelector<HTMLInputElement>('[data-search-input]');
    const results = dialog?.querySelector<HTMLElement>('[data-search-results]');
    const hint = dialog?.querySelector<HTMLElement>('[data-search-hint]');
    if (!dialog || !input || !results || !hint) return;
    let pagefind: any;
    let timer: number;
    const open = () => { dialog.showModal(); setTimeout(() => input.focus(), 30); };
    const close = () => { dialog.close(); input.value = ''; results.innerHTML = ''; hint.hidden = false; };
    document.querySelectorAll('[data-search-open]').forEach((button) => button.addEventListener('click', open, { signal }));
    dialog.querySelector('[data-search-close]')?.addEventListener('click', close, { signal });
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); }, { signal });
    addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); dialog.open ? close() : open(); }
    }, { signal });
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(async () => {
        const query = input.value.trim();
        if (!query) { results.innerHTML = ''; hint.hidden = false; return; }
        hint.hidden = true;
        results.replaceChildren();
        const loading = document.createElement('p'); loading.className = 'search-loading'; loading.textContent = '正在检索研究工作台…'; results.append(loading);
        try {
          if (!pagefind) {
            const base = import.meta.env.BASE_URL;
            const modulePath = `${base}pagefind/pagefind.js`;
            pagefind = await import(/* @vite-ignore */ modulePath);
            await pagefind.init();
          }
          const search = await pagefind.search(query);
          const data = await Promise.all(search.results.slice(0, 8).map((item: any) => item.data()));
          results.replaceChildren();
          if (data.length) {
            data.forEach((item: any) => {
              const link = document.createElement('a'); link.className = 'search-result'; link.href = item.url;
              const title = document.createElement('span'); title.textContent = item.meta?.title || '未命名内容';
              const excerpt = document.createElement('p'); excerpt.textContent = String(item.excerpt || item.meta?.description || '').replace(/<[^>]+>/g, '');
              link.append(title, excerpt); results.append(link);
            });
          } else {
            const empty = document.createElement('p'); empty.className = 'search-loading'; empty.textContent = '没有找到相关内容。'; results.append(empty);
          }
        } catch {
          results.replaceChildren();
          const error = document.createElement('p'); error.className = 'search-loading'; error.textContent = '开发模式暂无索引。请运行 npm run build 后使用全文搜索。'; results.append(error);
        }
      }, 180);
    }, { signal });
    signal.addEventListener('abort', () => clearTimeout(timer), { once: true });
  };
  bindSearch();
  document.addEventListener('astro:page-load', bindSearch);
</script>

<style>
  .search-dialog { inset: 0; width: min(680px, calc(100% - 28px)); max-height: max-content; margin: auto; padding: 0; border: 0; border-radius: 12px; background: transparent; color: var(--ink); }
  .search-dialog::backdrop { background: rgba(10, 13, 11, .54); backdrop-filter: blur(3px); }
  .search-panel { border: 1px solid var(--line); border-radius: 12px; background: var(--surface); box-shadow: var(--shadow); overflow: hidden; }
  header { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-bottom: 1px solid var(--line); color: var(--muted); }
  input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--ink); font-size: 1rem; }
  header button { width: 34px; height: 34px; display: grid; place-items: center; border: 0; border-radius: 6px; background: transparent; cursor: pointer; }
  header button:hover { background: var(--accent-soft); color: var(--accent); }
  .search-hint { min-height: 180px; display: flex; align-items: flex-start; justify-content: space-between; padding: 24px; color: var(--muted); font-size: .82rem; }
  .search-results { max-height: min(58vh, 520px); overflow: auto; }
  .search-result { display: block; padding: 17px 22px; border-bottom: 1px solid var(--line); }
  .search-result:hover { background: var(--accent-soft); }
  .search-result span { font-weight: 600; }
  .search-result p { margin: 5px 0 0; color: var(--muted); font-size: .84rem; line-height: 1.5; }
  .search-loading { padding: 26px 22px; color: var(--muted); }
  footer { display: flex; gap: 18px; padding: 11px 16px; border-top: 1px solid var(--line); color: var(--muted); font: 10px/1 var(--font-mono); }
  footer span { display: inline-flex; align-items: center; gap: 5px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
</style>
