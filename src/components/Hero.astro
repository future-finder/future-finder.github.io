---
import { ArrowDown } from '@lucide/astro';
import { profile } from '@/data/profile';
import { currentFocus } from '@/data/current';
---
<section class="hero">
  <div class="hero-grid shell">
    <div class="hero-main">
      <div class="hero-kicker"><span class="live-dot"></span><span>Research log / 2026—</span><span>BUAA · CN</span></div>
      <p class="identity">{profile.identity}</p>
      <h1><span>{profile.englishName}</span><small>{profile.name}</small></h1>
      <p class="role">{profile.roleEn} @ {profile.universityEn}</p>
      <p class="tagline">Exploring <em>large language models</em>,<br /> AI reliability, and intelligent systems.</p>
      <div class="hero-actions"><a href="#about-preview">Enter the workbench <span>↘</span></a><span>Research · Build · Learn · Write</span></div>
    </div>
    <aside class="focus-rail" aria-label="当前研究关注">
      <div class="rail-head"><span>STATUS / CURRENTLY</span><span>OPEN</span></div>
      {currentFocus.map((item, index) => <div class="rail-row"><span>0{index + 1}</span><div><b>{item.label}</b><p>{item.value}</p></div></div>)}
    </aside>
    <img class="hero-monogram" src={`${import.meta.env.BASE_URL}monogram.svg`} alt="" width="480" height="480" />
    <svg class="node-map" viewBox="0 0 560 210" aria-hidden="true">
      <g fill="none" stroke="currentColor"><path d="M12 148 104 70l89 47 72-82 91 96 74-54 116 65"/><path d="M12 148h534M104 70v78M193 117v31M265 35v113M356 131v17M430 77v71" opacity=".3"/></g>
      <g fill="currentColor"><circle cx="12" cy="148" r="4"/><circle cx="104" cy="70" r="4"/><circle cx="193" cy="117" r="4"/><circle cx="265" cy="35" r="4"/><circle cx="356" cy="131" r="4"/><circle cx="430" cy="77" r="4"/><circle cx="546" cy="142" r="4"/></g>
    </svg>
    <a class="scroll-cue" href="#about-preview"><ArrowDown size={16} /><span>Scroll to explore</span></a>
  </div>
</section>
<style>
  .hero { min-height: 82svh; position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero::before { content: ""; position: absolute; inset: 0; opacity: .46; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 64px 64px; mask-image: linear-gradient(90deg, black, transparent 78%); }
  .hero-grid { min-height: 82svh; padding: 134px 0 54px; position: relative; display: grid; grid-template-columns: minmax(0, 1.55fr) minmax(280px, .7fr); gap: 80px; align-items: center; }
  .hero-main { position: relative; z-index: 2; animation: hero-in .7s cubic-bezier(.2,.8,.2,1) both; }
  .hero-kicker { display: flex; gap: 24px; align-items: center; color: var(--muted); font: 10px/1 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px var(--accent-soft); }
  .identity { margin: 50px 0 8px; color: var(--accent); font: 600 12px/1 var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
  h1 { margin: 0; display: block; line-height: .86; letter-spacing: -.065em; }
  h1 span { display: block; font-size: clamp(4rem, 6.6vw, 7.4rem); font-weight: 560; white-space: nowrap; }
  h1 small { display: block; padding: 18px 0 0 3px; font-size: clamp(1.05rem, 1.5vw, 1.5rem); font-weight: 520; letter-spacing: .12em; }
  .role { margin: 25px 0 16px; color: var(--muted); font: 12px/1 var(--font-mono); }
  .tagline { margin: 0; max-width: 760px; font-size: clamp(1.45rem, 3.1vw, 3rem); line-height: 1.18; letter-spacing: -.04em; }
  .tagline em { color: var(--accent); font-style: normal; }
  .hero-actions { margin-top: 46px; display: flex; align-items: center; gap: 28px; }
  .hero-actions a { display: inline-flex; gap: 30px; align-items: center; border-bottom: 1px solid var(--ink); padding: 0 0 8px; font-weight: 600; }
  .hero-actions a:hover { color: var(--accent); border-color: var(--accent); }
  .hero-actions > span { color: var(--muted); font: 10px/1 var(--font-mono); letter-spacing: .08em; }
  .focus-rail { position: relative; z-index: 2; align-self: end; margin-bottom: 58px; border-top: 1px solid var(--ink); }
  .rail-head { display: flex; justify-content: space-between; padding: 12px 0; color: var(--muted); font: 9px/1 var(--font-mono); letter-spacing: .1em; }
  .rail-head span:last-child { color: var(--accent); }
  .rail-row { display: grid; grid-template-columns: 30px 1fr; gap: 10px; padding: 15px 0; border-top: 1px solid var(--line); }
  .rail-row > span { color: var(--accent); font: 9px/1.6 var(--font-mono); }
  .rail-row b { font-size: .77rem; }
  .rail-row p { margin: 2px 0 0; color: var(--muted); font-size: .72rem; line-height: 1.45; }
  .hero-monogram { position: absolute; right: 5%; top: 8%; width: min(38vw, 480px); color: var(--accent); opacity: .045; }
  .node-map { position: absolute; left: 48%; bottom: 8%; width: 46%; color: var(--accent); opacity: .12; }
  .scroll-cue { position: absolute; left: 0; bottom: 28px; display: inline-flex; align-items: center; gap: 9px; color: var(--muted); font: 9px/1 var(--font-mono); text-transform: uppercase; letter-spacing: .1em; }
  @keyframes hero-in { from { opacity: 0; transform: translateY(18px); } }
  @media (max-width: 980px) { .hero-grid { grid-template-columns: 1fr; align-content: center; gap: 36px; } .focus-rail { display: none; } .node-map { left: 45%; bottom: 10%; width: 60%; } }
  @media (max-width: 640px) { .hero, .hero-grid { min-height: 92svh; } .hero-grid { padding-top: 110px; padding-bottom: 76px; } .hero-kicker span:last-child { display: none; } .identity { margin-top: 38px; } h1 span { font-size: clamp(3.5rem, 17vw, 5.2rem); white-space: normal; } h1 small { padding: 15px 0 0; font-size: 1.12rem; letter-spacing: .1em; } .tagline br { display: none; } .hero-actions { align-items: flex-start; flex-direction: column; gap: 18px; } .hero-monogram, .node-map { display: none; } }
</style>
