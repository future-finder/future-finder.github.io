---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import TimelineList from '@/components/TimelineList.astro';
import { profile } from '@/data/profile';
import { currentFocus } from '@/data/current';
import { researchInterests } from '@/data/research';
const skills = [
  { group: 'Programming', items: ['C', 'Python'] },
  { group: 'Research', items: ['Paper Reading', 'Experimentation', 'Model Evaluation'] },
  { group: 'Tools', items: ['Git', 'Linux', 'VS Code'] },
];
---
<BaseLayout title="About | Hongyuan Zhang" description="关于张宏远：北航本科生，正在探索大语言模型与 AI 可靠性。" type="profile">
  <header class="about-hero shell"><div class="about-mark">HZ</div><div><span class="eyebrow">ABOUT / PROFILE</span><h1>A student building toward research.</h1><p>{profile.intro}</p></div></header>
  <section class="section"><div class="shell"><SectionHeader index="01" title="Currently" /><div class="currently-grid">{currentFocus.map((item) => <article><small>{item.label}</small><p>{item.value}</p></article>)}</div></div></section>
  <section class="section alt"><div class="shell"><SectionHeader index="02" title="Research interests" /><div class="interest-lines">{researchInterests.map((item) => <span>{item.title}</span>)}</div></div></section>
  <section class="section"><div class="shell about-split"><div><SectionHeader index="03" title="Education" /><article class="education"><span>BUAA</span><div><h3>{profile.university}</h3><p>{profile.role} · Undergraduate</p><small>Calculus · Linear Algebra · Data Structures · Discrete Mathematics · C Programming</small></div></article>{profile.weightedAverage && <p>Weighted Average: {profile.weightedAverage} / 100</p>}</div><div><SectionHeader index="04" title="Skills / tools" /><div class="skills">{skills.map((skill) => <article><small>{skill.group}</small><p>{skill.items.join(' · ')}</p></article>)}</div></div></div></section>
  <section class="section alt"><div class="shell about-split"><div><SectionHeader index="05" title="Research journey" /><TimelineList /></div><div class="beyond"><SectionHeader index="06" title="Beyond research" /><p>研究之外，我喜欢探索技术、动手构建、阅读，并思考智能系统可能如何改变世界。</p><span class="muted">Photography / Music / Life / Essays — space reserved for the future.</span></div></div></section>
</BaseLayout>
<style>
  .about-hero { padding: 160px 0 96px; display: grid; grid-template-columns: 220px 1fr; gap: 80px; align-items: start; }
  .about-mark { aspect-ratio: 1; display: grid; place-items: center; border: 1px solid var(--ink); font: 600 4.2rem/1 var(--font-mono); letter-spacing: -.12em; }
  .about-hero h1 { margin: 20px 0 24px; font-size: clamp(3rem, 7vw, 6.8rem); line-height: .96; letter-spacing: -.06em; font-weight: 560; }
  .about-hero p { max-width: 760px; color: var(--muted); font-size: 1.06rem; }
  .alt { background: var(--surface); }
  .currently-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--ink); }
  .currently-grid article { padding: 25px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  small { color: var(--accent); font: 9px/1 var(--font-mono); text-transform: uppercase; }
  .currently-grid p { margin: 12px 0 0; }
  .interest-lines { display: flex; flex-wrap: wrap; gap: 12px; }
  .interest-lines span { padding: 12px 16px; border: 1px solid var(--line); border-radius: 999px; font-size: .85rem; }
  .about-split { display: grid; grid-template-columns: repeat(2, 1fr); gap: 90px; }
  .about-split :global(.section-head) { display: block; }
  .about-split :global(.section-title) { margin-top: 18px; font-size: 2.5rem; }
  .education { display: grid; grid-template-columns: 70px 1fr; gap: 18px; border-top: 1px solid var(--ink); padding-top: 24px; }
  .education > span { color: var(--accent); font: 12px/1 var(--font-mono); }
  .education h3 { margin: 0; }
  .education p { margin: 4px 0 12px; color: var(--muted); }
  .education small { color: var(--muted); line-height: 1.6; }
  .skills article { padding: 19px 0; border-top: 1px solid var(--line); }
  .skills p { margin: 7px 0 0; }
  .beyond > p { max-width: 500px; font-size: 1.3rem; }
  .beyond > span { display: block; margin-top: 30px; font: 10px/1.7 var(--font-mono); }
  @media (max-width: 760px) { .about-hero { grid-template-columns: 1fr; gap: 36px; } .about-mark { width: 130px; } .about-split { grid-template-columns: 1fr; gap: 60px; } }
  @media (max-width: 500px) { .currently-grid { grid-template-columns: 1fr; } }
</style>
