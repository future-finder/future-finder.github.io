---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { researchInterests } from '@/data/research';
const readings = (await getCollection('research')).filter(e => e.data.status === 'reading');
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Research | Hongyuan Zhang" description="张宏远的研究实践、方法复现与论文阅读。">
<header class="page-hero shell"><span class="eyebrow">RESEARCH</span><h1>Understanding intelligence.<br/>One question at a time.</h1><p>从论文阅读到可验证的实验，探索模型的内部机制、能力与可靠性。</p></header>
<section class="section"><div class="shell"><div class="section-heading"><h2>Research Practice <span>研究实践</span></h2><span class="eyebrow">REPRODUCTION & EVALUATION</span></div><article class="research-feature"><a class="research-visual" href={`${base}research/lettucedetect/`}><picture><source media="(max-width: 540px)" srcset={`${base}visuals/evaluation-mobile.svg`}/><img src={`${base}visuals/evaluation.svg`} alt="LettuceDetect 在 RAGTruth 上的实验 F1" width="720" height="420"/></picture></a><div class="research-feature-copy"><span class="work-kind">MODERNBERT-BASE · RAGTRUTH · 2026.08</span><h3><a href={`${base}research/lettucedetect/`}>LettuceDetect</a></h3><p class="work-subtitle">RAG 场景下的细粒度幻觉检测复现与评测</p><p class="work-description">完整训练与评测链路，以及任务分布、检测粒度和误差来源的分析。</p><div class="metric-row"><div><strong>2,700</strong><span>测试样本</span></div><div><strong>0.7674</strong><span>Example F1</span></div><div><strong>0.5559</strong><span>Span F1</span></div></div><a class="text-link" href={`${base}research/lettucedetect/`}>完整实验报告 ↗</a></div></article></div></section>
<section class="section"><div class="shell"><div class="section-heading"><h2>Paper Reading <span>论文阅读</span></h2></div><div class="research-reading">{readings.map(entry => <a href={`${base}research/${entry.id}/`}><span class="reading-meta">{entry.data.dateLabel}<small>阅读笔记</small></span><div><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div><span>↗</span></a>)}</div></div></section>
<section class="section"><div class="shell"><div class="section-heading"><h2>Research Interests <span>研究兴趣</span></h2></div><div class="interest-grid">{researchInterests.map(item => <article><span class="interest-number">{item.id}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div></div></section>

<section class="section"><div class="shell"><div class="section-heading"><h2>Project Exploration <span>项目探索</span></h2></div><div class="research-reading"><a href={`${base}projects/eloveris/`}><span class="reading-meta">进行中<small>个人工程项目 · 项目笔记</small></span><div><h3>ELOVERIS：从一次英语演讲练习开始</h3><p>从真实的演讲练习需求出发，探索语音评测、证据支持的反馈与桌面软件开发。</p></div><span>↗</span></a></div></div></section>
</BaseLayout>
<style>.research-reading{border-top:1px solid var(--line)}.research-reading>a{display:grid;grid-template-columns:160px 1fr 20px;gap:30px;padding:27px 0;border-bottom:1px solid var(--line)}.reading-meta{font-size:11px;color:var(--muted)}.reading-meta small{display:block;font-size:10px;margin-top:8px}.research-reading h3{font:500 20px/1.6 var(--font-serif);margin:0}.research-reading p{font-size:13px;color:var(--muted);margin:7px 0 0}@media(max-width:540px){.research-reading>a{grid-template-columns:1fr 20px;gap:12px}.reading-meta{grid-column:1/-1}.reading-meta small{display:inline;margin-left:14px}.research-reading h3{font-size:18px}.section-heading>.eyebrow{display:none}}</style>
