---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { researchInterests } from '@/data/research';
import { social } from '@/data/social';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="About | Hongyuan Zhang" description="张宏远，北京航空航天大学软件工程专业本科生。教育背景、研究兴趣与个人经历。" type="profile">
<header class="page-hero shell about-heading"><div><span class="eyebrow">ABOUT ME</span><h1>Hongyuan Zhang <span>张宏远</span></h1><p>北京航空航天大学软件工程专业本科生。希望理解大模型的内部机制，并把研究问题落实为可信、可验证的实验与系统。</p><div class="about-links"><a href={`mailto:${social.email}`}>Email ↗</a><a href={social.github}>GitHub ↗</a></div></div><img src={`${base}visuals/landscape.svg`} alt="柔和山峦的原创插画，非个人肖像" width="640" height="760"/></header>
<section class="section"><div class="shell about-row"><h2>Education <span>教育背景</span></h2><div><div class="about-timeline"><time>2025.09 — 至今</time><h3>北京航空航天大学</h3><p>软件学院 · 软件工程专业本科生<br/>预计 2029 年毕业</p></div><div class="education-metrics"><div><b>3.8994<span>/ 4.0</span></b><small>必修课 GPA</small></div><div><b>92.81<span>/ 100</span></b><small>必修课加权平均分</small></div><div><b>前 5<span>/ 177</span></b><small>必修课排名</small></div></div><p class="small-note">工科数学分析（Ⅰ、Ⅱ）、高等代数、离散数学、数据结构与程序设计、人工智能导论。</p></div></div></section>
<section class="section"><div class="shell about-row"><h2>Research <span>研究兴趣</span></h2><div><div class="interest-lines">{researchInterests.map(i => <p><b>{i.title}</b><span>{i.description}</span></p>)}</div></div></div></section>
<section class="section"><div class="shell about-row"><h2>Engineering <span>工程实践</span></h2><div><div class="about-timeline"><time>2026.09 — 至今</time><h3><a href={`${base}projects/eloveris/`}>ELOVERIS · 英语口语练习与智能反馈</a></h3><p>Windows 桌面软件，已形成可安装测试的早期版本。口语评分与反馈方法仍在迭代。</p></div><div class="about-timeline"><time>进行中</time><h3><a href={`${base}projects/novelst/`}>NovelST · 长文本交互与结构化记忆探索</a></h3><p>围绕上下文一致性、历史信息检索和状态维护展开原型实践，完整闭环尚未完成。</p></div><div class="skills-lines"><p><small>编程</small><span>Python · C · Git</span></p><p><small>模型与实验</small><span>PyTorch · Transformers · vLLM · Conda</span></p><p><small>开发环境</small><span>Linux / SSH · VS Code · GCC / GDB</span></p></div></div></div></section>
<section class="section"><div class="shell about-row"><h2>Honors & Service <span>荣誉与工作经历</span></h2><ul class="honor-list"><li><span>01</span><p>蓝桥杯全国软件和信息技术专业人才大赛<b>省赛三等奖</b></p></li><li><span>02</span><p>校级三好学生</p></li><li><span>03</span><p>院级朋辈学业辅导师</p></li><li><span>04</span><p>新生梦拓（朋辈导师）</p></li></ul></div></section>
<section class="section"><div class="shell about-row"><h2>Contact <span>联系</span></h2><div><p class="contact-intro">欢迎交流研究问题、实验复现与工程实践。</p><a class="contact-email" href={`mailto:${social.email}`}>{social.email} ↗</a><p class="small-note"><a href={social.github}>github.com/future-finder</a></p></div></div></section>
</BaseLayout>
<style>.about-heading{display:grid;grid-template-columns:1fr 220px;gap:65px;align-items:center}.about-heading h1{font-size:48px}.about-heading h1 span{font-size:24px;display:block;margin-top:12px}.about-heading img{width:220px;height:220px;object-fit:cover;border-radius:8px}.about-links{display:flex;gap:24px;margin-top:25px;font-size:12px;color:var(--accent)}.about-row{display:grid;grid-template-columns:250px 1fr;gap:65px}.about-row>h2{font-size:27px;margin:0;line-height:1.3}.about-row>h2 span{display:block;font:12px/1.8 var(--font-sans);color:var(--muted);margin-top:10px}.about-timeline{border-left:1px solid var(--line);padding-left:24px;margin-bottom:28px;position:relative}.about-timeline::before{content:"";position:absolute;width:5px;height:5px;background:#80a3ce;border-radius:50%;left:-3px;top:8px}.about-timeline time{font:10px/1.7 var(--font-mono);color:var(--muted)}h3{font-size:18px;margin:10px 0 7px}.about-timeline p,.contact-intro{color:var(--muted);font-size:14px;line-height:1.9;margin:0 0 12px}.education-metrics{display:grid;grid-template-columns:repeat(3,1fr);padding:18px 0;border-block:1px solid var(--line);gap:20px}.education-metrics>div{display:grid;gap:7px}.education-metrics b{font:500 26px/1.2 var(--font-serif)}.education-metrics b span{font-size:12px;color:var(--muted);margin-left:6px}.education-metrics small{font-size:10px;color:var(--muted)}.small-note{font-size:12px;color:var(--muted);line-height:1.9}.interest-lines{margin-bottom:35px}.interest-lines p{margin:0 0 20px;display:grid;gap:7px;font-size:14px}.interest-lines b{font-weight:500}.interest-lines span{font-size:13px;color:var(--muted)}.skills-lines p{display:grid;grid-template-columns:105px 1fr;border-top:1px solid var(--line);padding:14px 0;margin:0;font-size:12px}.skills-lines small{color:var(--muted);font-size:11px}.honor-list{list-style:none;padding:0;margin:0}.honor-list li{display:grid;grid-template-columns:35px 1fr;gap:20px;border-bottom:1px solid var(--line);padding:16px 0}.honor-list li:first-child{padding-top:0}.honor-list li>span{font:10px/1.8 var(--font-mono);color:var(--muted)}.honor-list p{margin:0;font-size:14px}.honor-list b{display:block;color:var(--muted);font-weight:400;font-size:12px;margin-top:5px}.contact-email{font:24px/1.5 var(--font-serif);color:var(--accent)}@media(max-width:900px){.about-row{grid-template-columns:190px 1fr;gap:35px}.about-heading{gap:35px}.about-heading h1{font-size:40px}}@media(max-width:640px){.about-heading{grid-template-columns:1fr;gap:28px}.about-heading img{width:100%;height:150px;object-position:center 52%;grid-row:1}.about-heading h1{font-size:36px}.about-row{grid-template-columns:1fr;gap:28px}.education-metrics{gap:10px}.education-metrics b{font-size:23px}.education-metrics b span{font-size:10px}.contact-email{font-size:21px}}
</style>
