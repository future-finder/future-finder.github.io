---
import { Search, Menu, X } from '@lucide/astro';
import ThemeToggle from './ThemeToggle.astro';
const pathname = Astro.url.pathname;
const links = [
  ['Home', '/'], ['Research', '/research'], ['Writing', '/blog'],
  ['Projects', '/projects'], ['Notes', '/notes'], ['About', '/about'],
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hrefFor = (path: string) => `${base}${path}` || '/';
const active = (path: string) => path === '/' ? pathname === hrefFor('/') : pathname.startsWith(hrefFor(path));
---

<header class="navbar" data-navbar>
  <div class="nav-inner">
    <a class="brand" href={hrefFor('/')} aria-label="Hongyuan Zhang 首页">
      <span class="brand-mark" aria-hidden="true">HZ</span>
      <span class="brand-name"><b>ZH</b><small>Hongyuan</small></span>
    </a>
    <nav class="desktop-nav" aria-label="主导航">
      {links.map(([label, path]) => <a href={hrefFor(path)} aria-current={active(path) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="nav-actions">
      <button class="icon-button" type="button" data-search-open aria-label="打开全文搜索"><Search size={17} stroke-width={1.7} /><kbd>⌘K</kbd></button>
      <ThemeToggle />
      <button class="icon-button menu-button" type="button" data-menu-toggle aria-label="打开导航菜单" aria-expanded="false"><Menu class="menu-open" size={20} /><X class="menu-close" size={20} /></button>
    </div>
  </div>
  <nav class="mobile-nav" data-mobile-menu aria-label="移动端导航">
    {links.map(([label, path], index) => <a href={hrefFor(path)} aria-current={active(path) ? 'page' : undefined}><span class="mono">0{index + 1}</span>{label}</a>)}
  </nav>
</header>

<script>
  let navController: AbortController | undefined;
  const bindNav = () => {
    navController?.abort();
    navController = new AbortController();
    const { signal } = navController;
    const nav = document.querySelector<HTMLElement>('[data-navbar]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!nav || !toggle) return;
    const onScroll = () => nav.toggleAttribute('data-scrolled', scrollY > 24);
    addEventListener('scroll', onScroll, { passive: true, signal });
    toggle.addEventListener('click', () => {
      const open = !nav.hasAttribute('data-menu-open');
      nav.toggleAttribute('data-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '关闭导航菜单' : '打开导航菜单');
    }, { signal });
    nav.querySelectorAll('.mobile-nav a').forEach((link) => link.addEventListener('click', () => {
      nav.removeAttribute('data-menu-open');
      toggle.setAttribute('aria-expanded', 'false');
    }, { signal }));
    onScroll();
  };
  bindNav();
  document.addEventListener('astro:page-load', bindNav);
</script>

<style>
  .navbar { position: fixed; inset: 0 0 auto; z-index: 80; border-bottom: 1px solid transparent; transition: background .2s, border-color .2s, backdrop-filter .2s; }
  .navbar[data-scrolled], .navbar[data-menu-open] { background: var(--header); border-color: var(--line); backdrop-filter: blur(8px); }
  .nav-inner { width: min(1280px, calc(100% - 40px)); height: 72px; margin: auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; }
  .brand { justify-self: start; display: flex; align-items: center; gap: 10px; }
  .brand-mark { width: 34px; height: 34px; display: grid; place-items: center; border: 1px solid var(--ink); font: 700 10px/1 var(--font-mono); letter-spacing: -.06em; }
  .brand-name { display: grid; line-height: 1; }
  .brand-name b { font-size: 12px; letter-spacing: .12em; }
  .brand-name small { color: var(--muted); font: 10px/1.5 var(--font-mono); }
  .desktop-nav { display: flex; gap: 26px; align-items: center; }
  .desktop-nav a { position: relative; color: var(--muted); font-size: 13px; font-weight: 540; }
  .desktop-nav a::after { content: ""; position: absolute; inset: auto 0 -10px; height: 1px; background: var(--accent); transform: scaleX(0); transition: transform .2s; }
  .desktop-nav a:hover, .desktop-nav a[aria-current="page"] { color: var(--ink); }
  .desktop-nav a[aria-current="page"]::after { transform: scaleX(1); }
  .nav-actions { justify-self: end; display: flex; align-items: center; gap: 6px; }
  .icon-button { min-width: 38px; height: 38px; border: 0; background: transparent; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border-radius: 6px; cursor: pointer; }
  .icon-button:hover { background: var(--accent-soft); color: var(--accent); }
  kbd { color: var(--muted); font: 10px/1 var(--font-mono); }
  .menu-button { display: none; }
  .menu-close { display: none; }
  .mobile-nav { display: none; }
  @media (max-width: 980px) {
    .nav-inner { grid-template-columns: 1fr auto; }
    .desktop-nav { display: none; }
    .menu-button { display: inline-flex; }
    .navbar[data-menu-open] .menu-open { display: none; }
    .navbar[data-menu-open] .menu-close { display: block; }
    .mobile-nav { display: grid; grid-template-rows: repeat(6, 0fr); visibility: hidden; width: min(100% - 32px, 720px); margin: auto; transition: grid-template-rows .24s, padding .24s; }
    .mobile-nav a { overflow: hidden; min-height: 0; display: flex; gap: 18px; align-items: center; border-bottom: 1px solid var(--line); font-size: 1.4rem; }
    .mobile-nav a span { color: var(--accent); font-size: 10px; }
    .navbar[data-menu-open] .mobile-nav { grid-template-rows: repeat(6, 54px); visibility: visible; padding: 8px 0 24px; }
  }
  @media (max-width: 540px) { .brand-name { display: none; } kbd { display: none; } .nav-inner { width: calc(100% - 28px); height: 64px; } }
</style>
