---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { researchInterests } from '@/data/research';
const projects = (await getCollection('projects')).filter((item) => item.data.status === 'reproduction' || item.data.status === 'active');
---
<BaseLayout title="Research | Hongyuan Zhang" description="张宏远的研究兴趣、复现经历与研究旅程。">
  <header class="page-hero shell"><span class="eyebrow">RESEARCH / QUESTIONS</span><h1>Learning how to ask better questions.</h1><p>目前关注大语言模型、幻觉检测、RAG 与 AI 可靠性。我仍处于从课程基础走向真实科研过程的阶段，这里准确记录复现、实验和逐渐形成的问题意识。</p></header>
  <section class="section"><div class="shell"><SectionHeader index="01" title="Areas of inquiry" /><div class="research-list">{researchInterests.map((item) => <article><span>{item.id}</span><div><h2>{item.title}</h2><p>{item.description}</p></div></article>)}</div></div></section>
  <section class="section work"><div class="shell"><SectionHeader index="02" title="Research work" note="Reproduction 不等同于原创论文；状态与来源将始终明确标注。" /><div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div></div></section>
  <section class="section"><div class="shell statement"><span class="eyebrow">METHOD / PRINCIPLE</span><blockquote>先理解问题，再复现实验；先建立基础，再形成自己的研究判断。</blockquote><p>当前重点不是制造成果数量，而是训练论文阅读、实验设计、模型评估与工程实现能力。</p></div></section>
</BaseLayout>
<style>
  .research-list { border-top: 1px solid var(--ink); }
  .research-list article { display: grid; grid-template-columns: 110px 1fr; gap: 30px; padding: 30px 0; border-bottom: 1px solid var(--line); }
  .research-list span { color: var(--accent); font: 11px/1.5 var(--font-mono); }
  .research-list h2 { margin: 0; font-size: clamp(1.4rem, 3vw, 2.3rem); letter-spacing: -.035em; }
  .research-list p { max-width: 600px; color: var(--muted); }
  .work { background: var(--surface); }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .statement { display: grid; grid-template-columns: 180px 1fr; gap: 40px; }
  blockquote { margin: 0; font-size: clamp(1.6rem, 4vw, 3.5rem); line-height: 1.25; letter-spacing: -.04em; }
  .statement p { grid-column: 2; max-width: 620px; color: var(--muted); }
  @media (max-width: 700px) { .project-grid, .statement { grid-template-columns: 1fr; } .statement p { grid-column: 1; } .research-list article { grid-template-columns: 42px 1fr; gap: 14px; } }
</style>
