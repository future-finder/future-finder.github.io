---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import PostCard from '@/components/PostCard.astro';
import TimelineList from '@/components/TimelineList.astro';
import { profile } from '@/data/profile';
import { researchInterests } from '@/data/research';
import { currentFocus } from '@/data/current';

const showDrafts = import.meta.env.DEV;
const projects = (await getCollection('projects')).filter((item) => item.data.featured);
const posts = (await getCollection('blog')).filter((item) => showDrafts || !item.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<BaseLayout>
  <Hero />
  <section class="section intro-section" id="about-preview">
    <div class="shell">
      <SectionHeader index="01" title="A workbench in progress." note="不是终点陈列，而是一份持续更新的研究记录。" />
      <div class="intro-grid"><p>{profile.intro}</p><div class="intro-aside"><span class="eyebrow">POSITION / NOW</span><strong>An undergraduate<br />exploring AI research.</strong><a class="text-link" href={`${import.meta.env.BASE_URL}about/`}>More about me ↗</a></div></div>
    </div>
  </section>
  <section class="section interests-section">
    <div class="shell">
      <SectionHeader index="02" title="Research interests" note="从可靠性问题出发，逐步连接模型、算法与系统。" />
      <div class="interest-grid">{researchInterests.map((item) => <article><span>{item.id}</span><h3>{item.title}</h3><p>{item.description}</p></article>)}</div>
    </div>
  </section>
  <section class="section">
    <div class="shell">
      <SectionHeader index="03" title="Selected work" note="复现、实验与工程项目。每个状态都准确反映当前进度。" />
      <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
      <a class="section-link" href={`${import.meta.env.BASE_URL}projects/`}>View all projects <span>→</span></a>
    </div>
  </section>
  <section class="section writing-section">
    <div class="shell">
      <SectionHeader index="04" title="Recent writing" note={showDrafts ? '当前显示开发环境中的演示草稿。' : '研究、论文阅读、算法与工程记录。'} />
      {posts.length ? <div>{posts.map((post) => <PostCard post={post} />)}</div> : <div class="empty-state">正式文章正在整理中。开发环境提供演示草稿用于验证完整阅读体验。</div>}
      <a class="section-link" href={`${import.meta.env.BASE_URL}blog/`}>Open the writing archive <span>→</span></a>
    </div>
  </section>
  <section class="section focus-section">
    <div class="shell">
      <SectionHeader index="05" title="Current focus" note="一个刻意保持简单、可以随时更新的当前状态。" />
      <div class="focus-grid">{currentFocus.map((item, index) => <article><span>0{index + 1}</span><div><small>{item.label}</small><p>{item.value}</p></div></article>)}</div>
    </div>
  </section>
  <section class="section">
    <div class="shell timeline-grid"><SectionHeader index="06" title="A trajectory, not a résumé" note="只记录确定发生的节点，让时间逐渐形成研究者成长的上下文。" /><div><TimelineList limit={3} /><a class="text-link" href={`${import.meta.env.BASE_URL}timeline/`}>View full timeline →</a></div></div>
  </section>
</BaseLayout>

<style>
  .intro-section { background: var(--surface); }
  .intro-grid { display: grid; grid-template-columns: 1.35fr .65fr; gap: 100px; }
  .intro-grid > p { margin: 0; max-width: 760px; font-size: clamp(1.22rem, 2.3vw, 2rem); line-height: 1.65; letter-spacing: -.025em; }
  .intro-aside { padding-top: 10px; border-top: 1px solid var(--ink); display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .intro-aside strong { font-size: 1rem; line-height: 1.45; }
  .interests-section { overflow: hidden; }
  .interest-grid { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .interest-grid article { min-height: 250px; padding: 24px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); transition: background .2s; }
  .interest-grid article:hover { background: var(--accent-soft); }
  .interest-grid span { color: var(--accent); font: 10px/1 var(--font-mono); }
  .interest-grid h3 { margin: 58px 0 10px; font-size: 1.15rem; letter-spacing: -.02em; }
  .interest-grid p { margin: 0; color: var(--muted); font-size: .84rem; opacity: .72; transform: translateY(4px); transition: opacity .2s, transform .2s; }
  .interest-grid article:hover p { opacity: 1; transform: none; }
  .project-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .section-link { margin-top: 34px; display: flex; justify-content: space-between; border-bottom: 1px solid var(--ink); padding-bottom: 10px; font-size: .9rem; font-weight: 600; }
  .section-link:hover { color: var(--accent); border-color: var(--accent); }
  .writing-section { background: var(--surface); }
  .focus-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--ink); }
  .focus-grid article { display: grid; grid-template-columns: 50px 1fr; gap: 16px; padding: 26px 0; border-bottom: 1px solid var(--line); }
  .focus-grid article:nth-child(odd) { padding-right: 34px; }
  .focus-grid article:nth-child(even) { padding-left: 34px; border-left: 1px solid var(--line); }
  .focus-grid article > span { color: var(--accent); font: 10px/1.4 var(--font-mono); }
  .focus-grid small { color: var(--muted); font: 9px/1 var(--font-mono); text-transform: uppercase; letter-spacing: .1em; }
  .focus-grid p { margin: 7px 0 0; font-size: 1rem; }
  .timeline-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; }
  .timeline-grid :global(.section-head) { display: block; }
  .timeline-grid :global(.section-title) { margin-top: 20px; }
  @media (max-width: 800px) { .intro-grid, .timeline-grid { grid-template-columns: 1fr; gap: 48px; } .interest-grid { grid-template-columns: repeat(2, 1fr); } .project-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .interest-grid { grid-template-columns: 1fr; } .focus-grid { grid-template-columns: 1fr; } .focus-grid article:nth-child(n) { padding-inline: 0; border-left: 0; } }
</style>
