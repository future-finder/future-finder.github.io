---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, statusLabels } from '@/utils/content';
const notes = (await getCollection('notes')).filter((note) => import.meta.env.DEV || !note.data.draft).sort((a, b) => (b.data.updated || b.data.created).valueOf() - (a.data.updated || a.data.created).valueOf());
---
<BaseLayout title="Research Notes | Hongyuan Zhang" description="一个持续生长的研究笔记与论文阅读花园。">
  <header class="page-hero shell"><span class="eyebrow">NOTES / GARDEN</span><h1>Knowledge is allowed to grow.</h1><p>比博客更接近工作现场：Seed 是刚出现的问题，Growing 是持续更新的理解，Evergreen 是相对稳定的笔记。</p></header>
  <section class="section"><div class="shell"><div class="legend"><span><i data-state="seed"></i>Seed</span><span><i data-state="growing"></i>Growing</span><span><i data-state="evergreen"></i>Evergreen</span></div><div class="notes-grid">{notes.length ? notes.map((note, index) => <article><span class="note-index">N-{String(index + 1).padStart(3, '0')}</span><div><small>{statusLabels[note.data.status]} · {formatDate(note.data.updated || note.data.created)}</small><h2><a href={`${import.meta.env.BASE_URL}notes/${note.id}/`}>{note.data.title}</a></h2><p>{note.data.description}</p><div class="tag-list">{note.data.tags.map((tag) => <a class="tag" href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div></div></article>) : <div class="empty-state">研究笔记正在整理中。生产环境只显示正式公开的内容。</div>}</div></div></section>
</BaseLayout>
<style>
  .legend { display: flex; gap: 20px; padding: 12px 0 30px; border-top: 1px solid var(--ink); color: var(--muted); font: 9px/1 var(--font-mono); }
  .legend span { display: flex; gap: 7px; align-items: center; }
  .legend i { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .notes-grid article { display: grid; grid-template-columns: 100px 1fr; gap: 30px; padding: 32px 0; border-top: 1px solid var(--line); }
  .note-index { color: var(--accent); font: 10px/1.5 var(--font-mono); }
  small { color: var(--muted); font: 9px/1 var(--font-mono); text-transform: uppercase; }
  h2 { margin: 12px 0 7px; font-size: 1.5rem; letter-spacing: -.03em; }
  h2 a:hover { color: var(--accent); }
  p { margin: 0 0 18px; color: var(--muted); }
  @media (max-width: 560px) { .notes-grid article { grid-template-columns: 1fr; gap: 12px; } }
</style>
