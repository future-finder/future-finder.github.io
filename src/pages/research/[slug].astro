---
import { getCollection, render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { readingTime } from '@/utils/content';
export async function getStaticPaths() {
  return (await getCollection('research')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---
<PostLayout title={entry.data.title} description={entry.data.description} category={`${entry.data.kind} · ${entry.data.dateLabel}`} tags={entry.data.tags} minutes={readingTime(entry.body || '')} headings={headings}>
  {entry.id === 'lettucedetect' && <figure class="report-figure"><img src={`${import.meta.env.BASE_URL}visuals/evaluation.svg`} alt="RAGTruth 上 Example-level F1 0.7674，Span-level F1 0.5559，测试样本 2700 条" /><figcaption>RAGTruth · ModernBERT-base · F1（0–1）</figcaption></figure>}
  <Content />
</PostLayout>
