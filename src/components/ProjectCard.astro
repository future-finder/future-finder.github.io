---
import type { CollectionEntry } from 'astro:content';
import { statusLabels } from '@/utils/content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
---
<article class="project-card" data-pagefind-body data-project-status={project.data.status}>
  <div class="project-meta"><span>{project.data.type}</span><span>{project.data.year || '—'}</span></div>
  <div class="project-title"><span class="status-dot" data-status={project.data.status}></span><div><small>{statusLabels[project.data.status]}</small><h3 data-pagefind-meta="title">{project.data.title}</h3></div></div>
  <p data-pagefind-meta="description">{project.data.description}</p>
  <div class="tag-list">{project.data.tags.map((tag) => <a class="tag" href={`${import.meta.env.BASE_URL}tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div>
  <a class="project-link" href={`${import.meta.env.BASE_URL}projects/${project.id}/`}>查看记录 <span>↗</span></a>
</article>
<style>
  .project-card { min-height: 390px; padding: 22px; border: 1px solid var(--line); border-radius: 10px; background: color-mix(in srgb, var(--surface) 75%, transparent); display: flex; flex-direction: column; transition: border-color .2s, transform .2s; }
  .project-card:hover { border-color: var(--accent); transform: translateY(-3px); }
  .project-meta { display: flex; justify-content: space-between; color: var(--muted); font: 9px/1 var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
  .project-title { margin: 64px 0 22px; display: grid; grid-template-columns: 12px 1fr; gap: 12px; }
  .status-dot { margin-top: 8px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px var(--accent-soft); }
  .project-title small { color: var(--accent); font: 9px/1 var(--font-mono); }
  h3 { margin: 7px 0 0; font-size: 1.45rem; line-height: 1.2; letter-spacing: -.03em; }
  p { margin: 0 0 22px; color: var(--muted); font-size: .9rem; }
  .project-link { margin-top: auto; padding-top: 22px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; font-size: .82rem; font-weight: 600; }
  .project-link:hover { color: var(--accent); }
</style>
