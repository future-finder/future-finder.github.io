---
import { getCollection, render } from 'astro:content';
import PostLayout from '@/layouts/PostLayout.astro';
import { readingTime, statusLabels } from '@/utils/content';
export async function getStaticPaths() {
  return (await getCollection('notes')).filter((note) => import.meta.env.DEV || !note.data.draft).map((note) => ({ params: { slug: note.id }, props: { note } }));
}
const { note } = Astro.props;
const { Content, headings } = await render(note);
---
<PostLayout title={note.data.title} description={note.data.description} date={note.data.created} updated={note.data.updated} category={`Research Note · ${statusLabels[note.data.status]}`} tags={note.data.tags} minutes={readingTime(note.body || '')} draft={note.data.draft} headings={headings}><Content /></PostLayout>
